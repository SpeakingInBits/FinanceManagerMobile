// The five main screens.

import { ListView } from "std-widgets.slint";
import { Theme, Icons, Icon, IconBtn, Btn, Card, Segmented, Swatch, EmptyState } from "theme.slint";
import { MonthNav, PieChart, SankeyChart, BudgetCard } from "components.slint";
import { App, TxRow, CategoryRow } from "state.slint";

// Vertically scrolling page body.
component Page inherits Flickable {
    content-height: content.preferred-height;
    content-width: self.width;
    content := VerticalLayout {
        width: root.width;
        padding: Theme.space-4;
        spacing: Theme.space-5;
        @children
    }
}

component SectionTitle inherits Text {
    color: Theme.text;
    font-size: Theme.font-md;
    font-weight: 600;
    vertical-alignment: center;
}

component StatTile inherits Rectangle {
    in property <int> index;
    horizontal-stretch: 1;
    // Equal preferred widths so each row splits evenly whatever the figures' lengths.
    preferred-width: 100px;
    min-width: 0px;
    background: Theme.surface;
    border-color: Theme.border;
    border-width: 1px;
    border-radius: Theme.radius-md;
    VerticalLayout {
        padding: Theme.space-3;
        spacing: 2px;
        Text {
            text: index < App.stats.length ? App.stats[index].label : "";
            color: Theme.text-muted;
            font-size: Theme.font-sm;
            overflow: elide;
        }
        Text {
            text: index < App.stats.length ? App.stats[index].value : "";
            color: Theme.text;
            font-size: Theme.font-lg - 2px;
            font-weight: 700;
            overflow: elide;
        }
    }
}

component BudgetList inherits VerticalLayout {
    spacing: Theme.space-3;
    if App.budget-cards.length == 0: EmptyState {
        message: "No budgets yet";
        icon: Icons.wallet;
    }
    for card in App.budget-cards: BudgetCard { data: card; }
}

export component DashboardView inherits Page {
    MonthNav { }

    VerticalLayout {
        spacing: Theme.space-3;
        for row in 3: HorizontalLayout {
            spacing: Theme.space-3;
            StatTile { index: row * 2; }
            StatTile { index: row * 2 + 1; }
        }
    }

    Card {
        SectionTitle { text: "Budgets"; }
        HorizontalLayout {
            spacing: Theme.space-2;
            Btn {
                horizontal-stretch: 1;
                text: "Withdraw";
                secondary: true;
                enabled: App.can-withdraw;
                accessible-description: App.can-withdraw ? "" : "No budget has funds to withdraw";
                clicked => { App.open-withdraw(); }
            }
            Btn {
                horizontal-stretch: 1;
                text: "Allocate remaining";
                enabled: App.can-allocate;
                accessible-description: App.can-allocate ? "" : "No unallocated funds this month";
                clicked => { App.open-allocate(); }
            }
        }
        BudgetList { }
    }

    Card {
        HorizontalLayout {
            spacing: Theme.space-2;
            SectionTitle {
                text: "Expense breakdown";
                horizontal-stretch: 1;
            }
            Segmented {
                width: 170px;
                options: ["Combined", "Split"];
                selected <=> App.breakdown-view;
            }
        }
        if App.breakdown-view == 0: PieChart { data: App.expense-pie; }
        if App.breakdown-view == 1: VerticalLayout {
            spacing: Theme.space-4;
            HorizontalLayout {
                Text {
                    text: "Recurring";
                    color: Theme.text;
                    font-weight: 600;
                    horizontal-stretch: 1;
                }
                Text {
                    text: App.recurring-total;
                    color: Theme.text-muted;
                }
            }
            PieChart { data: App.recurring-pie; }
            HorizontalLayout {
                Text {
                    text: "One-time";
                    color: Theme.text;
                    font-weight: 600;
                    horizontal-stretch: 1;
                }
                Text {
                    text: App.onetime-total;
                    color: Theme.text-muted;
                }
            }
            PieChart { data: App.onetime-pie; }
        }
    }
}

component TransactionItem inherits Rectangle {
    in property <TxRow> entry;
    VerticalLayout {
        padding-left: Theme.space-4;
        padding-right: Theme.space-1;
        padding-top: Theme.space-2;
        padding-bottom: Theme.space-2;
        HorizontalLayout {
            spacing: Theme.space-3;
            Swatch {
                y: (parent.height - self.height) / 2;
                swatch: root.entry.color;
                width: 10px;
                height: 10px;
            }
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: 2px;
                Text {
                    text: root.entry.title;
                    color: Theme.text;
                    font-size: Theme.font-base;
                    overflow: elide;
                }
                Text {
                    text: root.entry.meta;
                    color: Theme.text-muted;
                    font-size: Theme.font-sm;
                    wrap: word-wrap;
                }
                if root.entry.budget-line != "": HorizontalLayout {
                    spacing: Theme.space-1;
                    Icon {
                        y: (parent.height - self.height) / 2;
                        icon: Icons.wallet;
                        color: Theme.primary;
                        width: 14px;
                        height: 14px;
                    }
                    Text {
                        text: root.entry.budget-line;
                        color: Theme.primary;
                        font-size: Theme.font-sm;
                        overflow: elide;
                        accessible-label: "Paid from budget: " + root.entry.budget-line;
                    }
                }
            }
            Text {
                text: root.entry.amount;
                font-size: Theme.font-base;
                font-weight: 600;
                vertical-alignment: center;
                color: root.entry.amount-kind == 0 ? Theme.income : root.entry.amount-kind == 1 ? Theme.expense : Theme.primary;
            }
            HorizontalLayout {
                IconBtn {
                    width: 38px;
                    icon: Icons.edit;
                    label: "Edit";
                    clicked => { App.edit-transaction(root.entry.id); }
                }
                IconBtn {
                    width: 38px;
                    icon: Icons.trash;
                    label: "Delete";
                    clicked => { App.delete-transaction(root.entry.id); }
                }
            }
        }
    }
}

export component TransactionsView inherits VerticalLayout {
    VerticalLayout {
        padding: Theme.space-4;
        padding-bottom: Theme.space-2;
        MonthNav { }
    }
    if App.tx-rows.length == 0: EmptyState {
        vertical-stretch: 1;
        message: "No transactions this month";
        icon: Icons.list;
    }
    if App.tx-rows.length > 0: ListView {
        vertical-stretch: 1;
        for row in App.tx-rows: VerticalLayout {
            if row.kind == 0: VerticalLayout {
                padding-left: Theme.space-4;
                padding-top: Theme.space-4;
                padding-bottom: Theme.space-1;
                Text {
                    text: row.title;
                    color: Theme.text;
                    font-size: Theme.font-md;
                    font-weight: 700;
                }
            }
            if row.kind == 1: HorizontalLayout {
                padding-left: Theme.space-4;
                padding-top: Theme.space-3;
                padding-bottom: Theme.space-1;
                spacing: Theme.space-2;
                Swatch {
                    y: (parent.height - self.height) / 2;
                    swatch: row.color;
                }
                Text {
                    text: row.title;
                    color: Theme.text;
                    font-size: Theme.font-base;
                    font-weight: 600;
                    horizontal-stretch: 1;
                }
            }
            if row.kind == 2: VerticalLayout {
                padding-left: Theme.space-5 + Theme.space-2;
                padding-top: Theme.space-2;
                Text {
                    text: row.title;
                    color: Theme.text-muted;
                    font-size: Theme.font-sm;
                    font-weight: 600;
                }
            }
            if row.kind == 3: TransactionItem { entry: row; }
        }
    }
}

component CategoryNode inherits Rectangle {
    in property <CategoryRow> entry;
    height: Theme.tap + 4px;
    HorizontalLayout {
        padding-left: root.entry.depth * 24px;
        spacing: Theme.space-1;
        if root.entry.has-children: IconBtn {
            width: 32px;
            icon: root.entry.collapsed ? Icons.chevron-right : Icons.chevron-down;
            label: root.entry.collapsed ? "Expand" : "Collapse";
            clicked => { App.toggle-category(root.entry.id); }
        }
        if !root.entry.has-children: Rectangle { width: 32px; }
        Swatch {
            y: (parent.height - self.height) / 2;
            swatch: root.entry.color;
        }
        Text {
            text: root.entry.name;
            color: Theme.text;
            font-size: Theme.font-base;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        IconBtn {
            width: 34px;
            icon: Icons.arrow-up;
            label: "Move up";
            enabled: root.entry.can-up;
            clicked => { App.move-category(root.entry.id, true); }
        }
        IconBtn {
            width: 34px;
            icon: Icons.arrow-down;
            label: "Move down";
            enabled: root.entry.can-down;
            clicked => { App.move-category(root.entry.id, false); }
        }
        if root.entry.depth == 0: IconBtn {
            width: 34px;
            icon: Icons.plus;
            label: "Add subcategory";
            clicked => { App.add-subcategory(root.entry.id); }
        }
        IconBtn {
            width: 34px;
            icon: Icons.edit;
            label: "Edit";
            clicked => { App.edit-category(root.entry.id); }
        }
        IconBtn {
            width: 34px;
            icon: Icons.trash;
            label: "Delete";
            clicked => { App.delete-category(root.entry.id); }
        }
    }
}

export component CategoriesView inherits Page {
    Card {
        pad: Theme.space-2;
        if App.category-rows.length == 0: EmptyState {
            message: "No categories yet";
            icon: Icons.tag;
        }
        VerticalLayout {
            for row in App.category-rows: CategoryNode { entry: row; }
        }
    }
}

export component BudgetsView inherits Page {
    BudgetList { }
}

export component ChartsView inherits Page {
    MonthNav { }
    Card {
        SectionTitle { text: "Breakdown by category"; }
        Segmented {
            options: ["Expense", "Income"];
            selected <=> App.pie-type;
            changed(i) => { App.pie-type-changed(i); }
        }
        PieChart { data: App.charts-pie; }
    }
    Card {
        SectionTitle { text: "Cash flow"; }
        SankeyChart { }
    }
}
